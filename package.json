{
	"name": "isa-wizard-2",
	"version": "0.0.0",
	"type": "module",
	"description": "ISA Wizard - An embeddable widget for collecting data through multi-step forms",
	"main": "./dist/widget.umd.js",
	"module": "./dist/widget.mjs",
	"types": "./dist/widget.d.ts",
	"exports": {
		".": {
			"import": "./dist/widget.mjs",
			"require": "./dist/widget.umd.js",
			"types": "./dist/widget.d.ts"
		},
		"./style": "./dist/style.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite",
		"build": "vite build && tsc --declaration --emitDeclarationOnly",
		"format": "prettier --write .",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/postcss": "^4.2.4",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^24.12.2",
		"autoprefixer": "^10.5.0",
		"daisyui": "^5.5.19",
		"json-schema-to-typescript": "^15.0.4",
		"postcss": "^8.5.14",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.55.4",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.4",
		"terser": "^5.46.2",
		"typescript": "~6.0.2",
		"vite": "^8.0.10"
	},
	"dependencies": {
		"@humanspeak/svelte-keyed": "^5.0.1",
		"svelecte": "^5.3.0"
	}
}
